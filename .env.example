# ─── Google AI Studio (Gemini) ────────────────────────────────────────────────
# Lấy API key tại: https://aistudio.google.com/apikey
# Đặt tên file thành .env và điền key vào dưới đây

VITE_GEMINI_API_KEY=

# ─── Tuỳ chọn: Proxy Server ───────────────────────────────────────────────────
# Nếu muốn dùng proxy server (node server/index.js) để ẩn API key khỏi browser:
# 1. Chạy: GEMINI_API_KEY=your_key node server/index.js
# 2. Bỏ comment dòng dưới:
# VITE_GEMINI_PROXY_URL=http://localhost:4000/api/gemini/generate

# ─── Notes ────────────────────────────────────────────────────────────────────
# - Nếu không có VITE_GEMINI_API_KEY, app sẽ dùng mock data mẫu (vẫn chạy được)
# - Model mặc định: gemini-flash-latest
